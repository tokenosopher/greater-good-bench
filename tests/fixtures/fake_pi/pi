#!/usr/bin/env python3
"""A fake `pi` binary for testing `art-crit run` without calling a real model.

Supports:
  pi --version
  pi --list-models
  pi --mode rpc --no-session --model M ...          (answers get_available_thinking_levels)
  pi -p --mode json --model M:LEVEL --session-dir D ... BRIEF   (writes a canned session + project)

Behavior knobs (env vars), read at `-p` run time:
  FAKE_PI_EXIT_CODE=N   exit N immediately, writing nothing (simulates a crashed harness)
  FAKE_PI_HANG=1        sleep "forever" (simulates a hung agent; the caller must kill it)
  FAKE_PI_ERROR_STOP=1  write a session whose last assistant message has stopReason "error"
  FAKE_PI_BAD_OUTPUT=1  (media briefs) also put an unreadable image and a stray text file in ./output/
  FAKE_PI_BAD_TEXT=1    (text briefs) write two .md files in ./output/, so the text step fails
  FAKE_PI_BAD_WEB=1     (web briefs) import a module that doesn't exist, so packaging fails
  FAKE_PI_EXTRA_MODELS=A,B  also list these models (with every level) in --list-models
  FAKE_PI_ARGV=FILE     write {argv, ART_CRIT_OPENROUTER_ROUTING, ART_CRIT_ROUTE_LOG} to FILE
  ART_CRIT_ROUTE_LOG       (set by art-crit for routed runs) append what the routing extension would log:
                        {id, provider} (the first requested upstream's name) and {id, cost: 0.0042}
  FAKE_PI_SERVED=NAME   report NAME as the upstream that served the request
  FAKE_PI_BLENDER_LIVE=1  (blender briefs) drive the real Blender MCP server from ./.pi/mcp.json (a monkey, a render and
                        a .glb) instead of writing canned files: an end-to-end check of the kind without a model

A blender brief (one mentioning .glb) gets ./output/ with a one-triangle scene.glb and a PNG render; the MCP config
art-crit gave it (./.pi/mcp.json) is copied to ./mcp-seen.json. A media brief (one mentioning ./output/) gets ./output/ with an SVG, a PNG and a 2s mp4 (made with
ffmpeg), plus a make.py and a leftover binary frame instead of a Godot project. A web brief (one
mentioning esbuild) gets index.html + main.js + style.css and a fake npm package in node_modules/. A text brief
(one asking for "one Markdown file") gets ./output/essay.md (with a heading, a list, a link and a raw <script>) plus
notes.md outside ./output/.
"""
import base64
import json
import struct
import subprocess
import os
import sys
import time
import uuid
from pathlib import Path

VERSION = "0.1.0-fake"
# A valid 1x1 PNG.
PNG_1X1 = base64.b64decode(
    "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
)

# model -> supported thinking levels, in LEVEL_ORDER. Anything else defaults to the full set.
MODEL_LEVELS = {
    "openai-codex/gpt-6-sol": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
    "openai-codex/gpt-6-luna": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
    "test/limited": ["low", "medium", "high"],
    "anthropic/claude-opus-5-5": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
    "openrouter/openai/gpt-6-sol:batch": ["off", "low", "medium", "high", "xhigh", "max"],  # ':' in the id
    "openrouter/test/model": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
}
# FAKE_PI_EXTRA_MODELS="a/b,c/d" lists more models (every level), e.g. a real set from art-crit.toml.
MODEL_LEVELS.update({m: ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
                     for m in os.environ.get("FAKE_PI_EXTRA_MODELS", "").split(",") if m})


def arg(flag):
    if flag in sys.argv:
        i = sys.argv.index(flag)
        if i + 1 < len(sys.argv):
            return sys.argv[i + 1]
    return None


def cmd_version():
    print(VERSION)


def cmd_list_models():
    print("provider        model                                               context  max-out  thinking  images")
    seen = set()
    for full in MODEL_LEVELS:
        provider, model = full.split("/", 1)
        if full in seen:
            continue
        seen.add(full)
        print(f"{provider:<15} {model:<50} 128K     64K      yes       no")


def cmd_rpc():
    model = arg("--model")
    line = sys.stdin.readline()
    try:
        request = json.loads(line)
    except (json.JSONDecodeError, TypeError):
        request = {}
    if request.get("type") == "get_available_thinking_levels":
        levels = MODEL_LEVELS.get(model, ["off", "minimal", "low", "medium", "high", "xhigh", "max"])
        resp = {"type": "response", "command": "get_available_thinking_levels", "success": True, "data": {"levels": levels}}
        print(json.dumps(resp))
        sys.stdout.flush()


def emit(obj):
    print(json.dumps(obj))
    sys.stdout.flush()


def cmd_run():
    model_level = arg("--model")
    session_dir = Path(arg("--session-dir"))
    brief = sys.argv[-1]
    provider, rest = model_level.split("/", 1)
    model_id, level = rest.split(":", 1)

    argv_file = os.environ.get("FAKE_PI_ARGV")
    if argv_file:
        Path(argv_file).write_text(json.dumps({
            "argv": sys.argv,
            "routing": os.environ.get("ART_CRIT_OPENROUTER_ROUTING"),
            "route_log": os.environ.get("ART_CRIT_ROUTE_LOG"),
        }))
    route_log = os.environ.get("ART_CRIT_ROUTE_LOG")
    if route_log:
        # Like the routing extension: OpenRouter's display name of the first requested upstream
        # ("deepinfra/fp8" -> "Deepinfra"), or FAKE_PI_SERVED, then the charge from the final chunk.
        routing = json.loads(os.environ.get("ART_CRIT_OPENROUTER_ROUTING") or "{}")
        slug = (routing.get("only") or ["fake"])[0]
        served = os.environ.get("FAKE_PI_SERVED") or slug.split("/")[0].capitalize()
        Path(route_log).parent.mkdir(parents=True, exist_ok=True)
        with open(route_log, "a", encoding="utf-8") as f:
            f.write(json.dumps({"id": "gen-fake-1", "provider": served}) + "\n")
            f.write(json.dumps({"id": "gen-fake-1", "cost": 0.0042}) + "\n")

    if os.environ.get("FAKE_PI_HANG"):
        Path("fake_pi.pid").write_text(str(os.getpid()))  # lets a test check this exact process died
        time.sleep(3600)
        return

    exit_code = os.environ.get("FAKE_PI_EXIT_CODE")
    if exit_code and int(exit_code) != 0:
        print("fake pi: forced failure", file=sys.stderr)
        sys.exit(int(exit_code))

    if ".glb" in brief:
        write_blender()
    elif "one Markdown file" in brief:
        write_text()
    elif "./output/" in brief:
        write_media()
    elif "esbuild" in brief:
        write_web()
    else:
        # A tiny fake Godot project, just enough for the import step to find "source" files.
        Path("project.godot").write_text("config_version=5\n")
        Path("README.md").write_text(f"# fake project\nBuilt for: {brief[:40]}\n")
        Path("scenes").mkdir(exist_ok=True)
        Path("scripts").mkdir(exist_ok=True)
        (Path("scenes") / "main.tscn").write_text("[gd_scene load_steps=1 format=3]\n")
        (Path("scripts") / "main.gd").write_text("extends Node\nfunc _ready():\n\tpass\n")

    session_dir.mkdir(parents=True, exist_ok=True)
    session_id = str(uuid.uuid4())
    session_path = session_dir / f"2026-09-27T00-00-00-000Z_{session_id}.jsonl"

    error_stop = bool(os.environ.get("FAKE_PI_ERROR_STOP"))
    usage1 = {"input": 500, "output": 100, "cacheRead": 200, "cacheWrite": 0, "reasoning": 10,
              "totalTokens": 600, "cost": {"input": 0.001, "output": 0.0005, "cacheRead": 0, "cacheWrite": 0, "total": 0.0015}}
    usage2 = {"input": 300, "output": 80, "cacheRead": 150, "cacheWrite": 0, "reasoning": 5,
              "totalTokens": 380, "cost": {"input": 0.0006, "output": 0.0004, "cacheRead": 0, "cacheWrite": 0, "total": 0.001}}

    lines = [
        {"type": "session", "id": session_id, "timestamp": "2026-09-27T00:00:00.000Z", "cwd": os.getcwd()},
        {"type": "model_change", "provider": provider, "modelId": model_id},
        {"type": "thinking_level_change", "thinkingLevel": level},
        {"type": "message", "message": {"role": "system", "content": ""}},
        {"type": "message", "message": {"role": "user", "content": [{"type": "text", "text": brief}]}},
        {"type": "message", "timestamp": "2026-09-27T00:00:01.000Z", "message": {
            "role": "assistant", "usage": usage1, "stopReason": "toolUse",
            "content": [{"type": "text", "text": "Writing the project."}, {"type": "toolCall", "id": "t1", "name": "write"}],
        }},
        {"type": "message", "timestamp": "2026-09-27T00:00:03.500Z",
         "message": {"role": "toolResult", "toolCallId": "t1", "content": "wrote project.godot"}},
        {"type": "message", "message": {
            "role": "assistant", "usage": usage2,
            "stopReason": "error" if error_stop else "stop",
            **({"errorMessage": "fake induced error"} if error_stop else {}),
            "content": [{"type": "text", "text": "Done. Summary: built a fake project."}],
        }},
    ]

    emit({"type": "session"})
    emit({"type": "agent_start"})
    for line in lines:
        emit({"type": "message_start"})
        emit({"type": "message_update"})
        session_path.parent.mkdir(parents=True, exist_ok=True)
        with open(session_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(line) + "\n")
        emit({"type": "message_end"})
    emit({"type": "agent_end"})
    emit({"type": "agent_settled"})


def write_media():
    out = Path("output")
    out.mkdir(exist_ok=True)
    (out / "drawing.svg").write_text(
        f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80"><!-- drawn in {os.getcwd()} -->'
        '<circle cx="60" cy="40" r="30" fill="tomato"/></svg>'
    )
    (out / "dot.png").write_bytes(PNG_1X1)
    subprocess.run(["ffmpeg", "-y", "-v", "error", "-f", "lavfi", "-i", "testsrc=size=160x120:rate=10", "-t", "2",
                    "-c:v", "libx264", "-pix_fmt", "yuv420p", str(out / "clip.mp4")], check=True)
    if os.environ.get("FAKE_PI_BAD_OUTPUT"):
        (out / "broken.png").write_bytes(b"not a png")
        (out / "notes.txt").write_text("not media")  # not an output: skipped by the media step, still source
    Path("make.py").write_text("print('made the files')\n")
    Path("frames").mkdir(exist_ok=True)
    (Path("frames") / "f001.png").write_bytes(PNG_1X1)  # a leftover binary: never published as source


def write_text():
    out = Path("output")
    out.mkdir(exist_ok=True)
    (out / "essay.md").write_text(
        "# On Fake Essays\n\n"
        f"Written in {os.getcwd()} by a **fake** agent, with a [link](https://example.com).\n\n"
        "- one point\n- another point\n\n<script>window.fakeEssayRan = true</script>\n"
    )
    if os.environ.get("FAKE_PI_BAD_TEXT"):
        (out / "second.md").write_text("# Another\n")
    Path("notes.md").write_text("outline: say something\n")


def tiny_glb():
    """A valid glTF 2.0 binary with one triangle."""
    positions = struct.pack("<9f", 0, 0, 0, 1, 0, 0, 0, 1, 0)
    gltf = {"asset": {"version": "2.0"}, "scene": 0, "scenes": [{"nodes": [0]}], "nodes": [{"mesh": 0}],
            "meshes": [{"primitives": [{"attributes": {"POSITION": 0}}]}],
            "accessors": [{"bufferView": 0, "componentType": 5126, "count": 3, "type": "VEC3",
                           "min": [0, 0, 0], "max": [1, 1, 0]}],
            "bufferViews": [{"buffer": 0, "byteLength": len(positions)}], "buffers": [{"byteLength": len(positions)}]}
    js = json.dumps(gltf).encode()
    js += b" " * (-len(js) % 4)
    body = struct.pack("<II", len(js), 0x4E4F534A) + js + struct.pack("<II", len(positions), 0x004E4942) + positions
    return struct.pack("<III", 0x46546C67, 2, 12 + len(body)) + body


def blender_live(spec):
    """Like a model would: build, render and export through the Blender MCP server art-crit started for this run."""
    proc = subprocess.Popen([spec["command"], *spec["args"]], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, env={**os.environ, **spec.get("env", {})}, text=True)

    def rpc(i, method, params=None):
        msg = {"jsonrpc": "2.0", "method": method, **({"id": i} if i else {}), **({"params": params} if params else {})}
        proc.stdin.write(json.dumps(msg) + "\n")
        proc.stdin.flush()
        return json.loads(proc.stdout.readline()) if i else None

    rpc(1, "initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "fake", "version": "0"}})
    rpc(None, "notifications/initialized")
    code = (
        "import bpy, os\nos.makedirs('output', exist_ok=True)\n"
        "bpy.data.objects['Cube'].hide_render = True\nbpy.data.objects['Cube'].hide_set(True)\n"
        "bpy.ops.mesh.primitive_monkey_add()\nbpy.ops.object.shade_smooth()\n"
        "m = bpy.data.materials.new('fake'); m.diffuse_color = (0.9, 0.35, 0.2, 1); bpy.context.object.data.materials.append(m)\n"
        "bpy.context.scene.render.resolution_x, bpy.context.scene.render.resolution_y = 640, 480\n"
        "bpy.context.scene.render.filepath = os.path.abspath('output/render.png')\nbpy.ops.render.render(write_still=True)\n"
        "bpy.ops.export_scene.gltf(filepath=os.path.abspath('output/scene.glb'), export_format='GLB', use_visible=True)\n"
        "result = {'ok': True}"
    )
    reply = rpc(2, "tools/call", {"name": "execute_blender_code", "arguments": {"code": code}})
    Path("blender-reply.json").write_text(json.dumps(reply))
    proc.stdin.close()
    proc.terminate()


def write_blender():
    config = Path(".pi") / "mcp.json"
    if config.is_file():
        Path("mcp-seen.json").write_text(config.read_text())
    if os.environ.get("FAKE_PI_BLENDER_LIVE"):
        return blender_live(json.loads(config.read_text())["mcpServers"]["blender"])
    out = Path("output")
    out.mkdir(exist_ok=True)
    (out / "scene.glb").write_bytes(tiny_glb())
    (out / "render.png").write_bytes(PNG_1X1)


def write_web():
    Path("index.html").write_text(
        '<!doctype html><html><head><link rel="stylesheet" href="style.css"></head>'
        '<body><canvas id="c"></canvas><script type="module" src="main.js"></script></body></html>\n'
    )
    Path("style.css").write_text("body { margin: 0; background: #123; }\n")
    missing = 'import "./missing.js";\n' if os.environ.get("FAKE_PI_BAD_WEB") else ""
    Path("main.js").write_text(
        f'{missing}import {{ spin }} from "fakepkg";\n'
        f'console.log("built in {os.getcwd()}");\n'
        'document.title = spin("horse");\n'
    )
    pkg = Path("node_modules") / "fakepkg"
    pkg.mkdir(parents=True, exist_ok=True)
    (pkg / "package.json").write_text('{"name": "fakepkg", "version": "1.0.0", "main": "index.js"}\n')
    (pkg / "index.js").write_text('export function spin(s) { return "spinning " + s; }\n')
    Path("package.json").write_text('{"dependencies": {"fakepkg": "1.0.0"}}\n')


def main():
    if "--version" in sys.argv:
        return cmd_version()
    if "--list-models" in sys.argv:
        return cmd_list_models()
    if "--mode" in sys.argv and arg("--mode") == "rpc":
        return cmd_rpc()
    if "-p" in sys.argv:
        return cmd_run()
    print(f"fake pi: unrecognized invocation: {sys.argv[1:]}", file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main()
