; Common Ground — a self-contained Godot 4 project.
config_version=5

[application]
config/name="Common Ground"
config/description="A ten-week strategy game about mutual aid, resilient neighborhoods, and leaving no one behind."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.949, 0.957, 0.933, 1)

[threads]
worker_pool/max_threads=0
