; Common Ground — a self-contained neighborhood game.
config_version=5

[application]
config/name="Common Ground"
config/description="A little neighborhood. A little care. A better place for everyone."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.071, 0.137, 0.141, 1)

[audio]
driver/enable_input=false

[editor_plugins]
enabled=PackedStringArray()
