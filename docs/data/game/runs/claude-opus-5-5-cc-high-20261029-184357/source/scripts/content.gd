extends RefCounted
## All game text: the six manipulation techniques and the posts in each chapter.
## A post's "a" is its main technique id, or "honest". "also" lists other
## techniques that count as a correct answer.

const HONEST_SIGNS := "Signs of honest info: a named source you can check, a calm tone, admitting what isn't known, and correcting mistakes."

const TECH_ORDER := ["emotion", "expert", "choice", "scapegoat", "attack", "cherry"]

const TECHNIQUES := {
	"emotion": {
		"name": "Emotional Bait",
		"color": "#ff6b6b",
		"question": "Is it trying to make me scared or angry before I think?",
		"explain": "Manipulative posts are packed with alarming words like TERRIFYING, DISGUSTING and SHARE NOW, because strong emotions make us share before we check. Underneath, the facts are usually thin or missing.",
		"example": "\"I'm SHAKING with rage. If you care about your family you will share this IMMEDIATELY!!!\"",
	},
	"expert": {
		"name": "Fake Expert",
		"color": "#ffa94d",
		"question": "Who is actually saying this, and do they really know this field?",
		"explain": "Posts borrow authority they don't have: an anonymous 'doctor', a celebrity talking outside their field, an official-looking account that isn't official, an institute nobody has heard of. Real expertise is named, relevant and checkable.",
		"example": "\"A top scientist (who must stay anonymous) told me the vaccine is a scam.\"",
	},
	"choice": {
		"name": "False Choice",
		"color": "#ffd43b",
		"question": "Are there really only two options?",
		"explain": "Presenting two extremes as the only possibilities hides every middle path. It pushes people into opposing camps. Real problems almost always have many possible answers.",
		"example": "\"Either we close every shop, or we accept that people will die. Pick one.\"",
	},
	"scapegoat": {
		"name": "Scapegoat",
		"color": "#b197fc",
		"question": "Is one group being blamed for a complicated problem?",
		"explain": "Pinning a complex problem on a single group (newcomers, young people, one neighbourhood) feels satisfying, but it's almost never true. It also turns neighbours against each other.",
		"example": "\"Prices are up, the streets are dirty, and jobs are gone. We all know who to blame.\"",
	},
	"attack": {
		"name": "Personal Attack",
		"color": "#f783ac",
		"question": "Is it attacking the person instead of their argument?",
		"explain": "Mocking someone's looks, past or character avoids the actual question. An argument is right or wrong no matter who makes it.",
		"example": "\"Why listen to her about the economy? Look at what she's wearing.\"",
	},
	"cherry": {
		"name": "Cherry-Picking",
		"color": "#4dabf7",
		"question": "Is one story or number standing in for the whole picture?",
		"explain": "One vivid anecdote, one carefully chosen statistic or one cropped photo can 'prove' almost anything. Ask what the full picture shows: how many cases, over what time, compared to what?",
		"example": "\"My uncle smoked every day and lived to 95. So smoking is fine.\"",
	},
}

