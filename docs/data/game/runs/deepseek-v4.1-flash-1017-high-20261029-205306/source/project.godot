; Engine configuration file.
; Common Ground - a game about finding what we share.

config_version=5

[application]

config/name="Common Ground"
config/icon="res://icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A short game about listening, interests, and solutions that include everyone."

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.956863, 0.929412, 0.882353, 1)
textures/default_filters/use_nearest_mipmap_filter=false
