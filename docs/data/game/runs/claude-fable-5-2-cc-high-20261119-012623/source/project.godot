; Engine configuration file.
; Steady Hands - a first-aid game.

config_version=5

[application]

config/name="Steady Hands"
config/description="One ordinary day. Five moments where the nearest person is you. A first-aid game."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.133, 0.188, 0.247, 1)
